{
  "name": "performance-diagnosis",
  "version": "0.1.0",
  "description": "Web black-box performance diagnosis agent built with LangGraph.js and Chrome DevTools MCP.",
  "type": "module",
  "bin": {
    "perf-agent": "./dist/cli/diagnose.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli/diagnose.ts diagnose --task ./tasks/sample-chat-switch.md",
    "diagnose": "tsx src/cli/diagnose.ts diagnose",
    "start": "node dist/cli/diagnose.js diagnose",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "performance",
    "diagnosis",
    "langgraph",
    "mcp",
    "chrome-devtools"
  ],
  "license": "MIT",
  "dependencies": {
    "@langchain/langgraph": "^1.4.14",
    "@langchain/mcp-adapters": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chrome-devtools-mcp": "^1.8.0",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
